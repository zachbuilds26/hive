# HIVE mode: "sim" (no keys needed, runs everywhere) or "real" (live OKX trades)
HIVE_MODE=sim

# X Layer testnet (195) / mainnet (196)
XLAYER_CHAIN_ID=195
XLAYER_RPC_URL=https://xlayer-testnet.okx.com

# OKX API credentials (OnchainOS / DEX) — required only for real mode
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# LLM used by Analyst for scoring — works with OpenAI or any
# OpenAI-compatible provider (e.g. Groq free: base https://api.groq.com/openai/v1)
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Trading universe
BASE_TOKEN=USDG
QUOTE_TOKEN=OKB
OKX_INST_ID=OKB-USDT

# Agent behavior
CHECK_INTERVAL_MINUTES=30
EXECUTOR_SWAP_AMOUNT=10
ANALYST_THRESHOLD=40
SEED_CAPITAL=100

# Auto-start the loop on boot
AUTO_START=false

PORT=3001
