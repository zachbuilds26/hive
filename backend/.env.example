# HIVE mode: "sim" (no keys needed, runs everywhere) or "real" (live OKX trades)
HIVE_MODE=sim

# X Layer testnet (195) / mainnet (196)
XLAYER_CHAIN_ID=195
XLAYER_RPC_URL=https://xlayer-testnet.okx.com

# OKX API credentials (OnchainOS / DEX) — required only for real mode
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# OpenAI key — used by Analyst for LLM scoring; falls back to rules without it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Trading universe
BASE_TOKEN=USDG
QUOTE_TOKEN=OKB
OKX_INST_ID=OKB-USDT

# Agent behavior
CHECK_INTERVAL_MINUTES=30
EXECUTOR_SWAP_AMOUNT=10
ANALYST_THRESHOLD=40
SEED_CAPITAL=100

# Auto-start the loop on boot
AUTO_START=false

PORT=3001